{
  "rewrites": [
    {
      "source": "/",
      "destination": "/vasil-isachki/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/vasil-isachki/assets/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/stamen",
      "destination": "/stamen/",
      "permanent": false
    },
    {
      "source": "/tony-intense",
      "destination": "/tony-intense/",
      "permanent": false
    },
    {
      "source": "/intns",
      "destination": "/intns/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noai, noimageai"
        }
      ]
    }
  ]
}
